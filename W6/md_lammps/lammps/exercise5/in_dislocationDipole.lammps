#
# General simulation parameters
#
dimension       3
atom_style      atomic
units           metal
boundary        p p p
#
# Read in initial configuration generated by createDislocationDipole.py
#
read_data       dislocationDipole.lammps
#
# Define atomic masses of atom (Cu and Zr)
#
mass 1 63.546  
mass 2 91.224
#
# Save starting configuration
#
write_data initial_lattice.lammps
#
# Define empirical interatomic force
#
pair_style    eam/fs
pair_coeff    * * CuZr_mm.eam.fs Cu Zr
pair_modify   shift yes
#
# Define neighbour list parameters
#
neighbor   0.3  bin
neigh_modify  every  1  delay  0  check  yes
#
# Define output of thermodynamic variables
#
thermo 1
thermo_style custom step time temp pe ke press vol
#
# Relax at fixed volume to a new zero-force configuration
#
write_data initial_state.lammps
minimize 1.0e-15 1e-15 10000 10000
write_data final_state.lammps
#
# Set time step of 1 femto-second
#
timestep 0.001
#
# Set temperature to 300K
#
velocity all create 300.0 12345
#
# Equilibriation: high temperature NVT liquid simulation at zero pressure & T=4000K
#
log log_dislocationDipole.lammps
fix 1 all npt temp 300.0 300.0 0.01 iso 0.0 0.0 1.0
dump eqiul all atom 100 dislocationDipole.atom
thermo 100
run 100000



